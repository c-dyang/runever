# ============================================================
# RunEver 自动执行配置（匹配块）
# 编码: UTF-8 (无 BOM)
#
# 用途：选中文本 → 匹配插件 → 直接执行（不弹菜单）
# 插件目录：config\functions\*.ahk（丢文件即生效，无需改本文件）
#
# 说明：
#   enabled     总开关（0 = 关闭自动执行，全部走菜单）
#   minLen      选中文本最小长度（防单字误触发）
#   cacheSeconds 插件元数据缓存（秒）；0 = 每次重扫（调试用：每次按键都重扫插件目录）
#      ⚠ AHK 版的实现与本行相反（0 = 永不重扫，见 src\AutoMatcher.ahk:99）；
#        C# 版按本行成文口径执行 —— 只有把本值显式设成 0 时两边行为不同。
#
#   ★ showByDefault  插件【未声明 RVE_FN_Show】时的默认行为
#        0 = 隐藏执行窗口（默认，与存量行为一致）
#        1 = 显示执行窗口
#      单条插件要显示窗口 → 在插件文件里写  global RVE_FN_Show := true
#      （设置 UI 的「显示窗口」勾选就是改这一行）
#
#   ★ waitWhenShown  显示窗口时是否等待命令结束
#        1 = 等待（默认）—— cmd 窗口留存，进度/结果/报错都看得见
#        0 = 不等待      —— 执行器立即退出，窗口可能被连带关闭
#      仅"显示"生效；隐藏模式一律不等待（架构约束：主程序零阻塞）
# ============================================================

enabled=1
minLen=4
cacheSeconds=300
showByDefault=0
waitWhenShown=1

# ★ 日志级别：0=关闭 1=简略（默认）2=详细（含分阶段耗时明细）
#   关闭后热键响应略快（省去每次文件写入）；日志在 state\runever-cs.log
log=1

# ★ 缺件自动隐藏（0 = 关 / 1 = 开，默认关）
#   开 = 菜单里【本机解析不到】的条目自动不显示（配置可能来自另一台机器）：
#        · run  条目：首个 token（程序名）在 路径缓存 → PATH → App Paths 都解析不到
#        · open 条目：目标文件/目录不存在
#        · url / action / send / keys 不判；目标含 %file%/%text% 等占位符的条目不判
#   判定只查缓存与系统原生解析（毫秒级），不调 es/EV 搜索 —— 全量解析请用
#   托盘「刷新路径缓存」，它把结果落进 cache\paths.txt 供这里使用。
hideMissing=1

# ★ 触发热键（选中文本后按它 → 采集 → 匹配 → 弹菜单/自动执行）
#   写法：单键用 `（反引号），或 F1-F24、Space/Tab/Enter/Esc/Home/End/PgUp/PgDn/方向键
#   修饰符前缀：^=Ctrl  !=Alt  +=Shift  #=Win（可叠加，如 ^!r、#F12）
#   ⚠ 裸字母/数字会被拒绝 —— 那等于按一下就弹菜单，会吞掉正常打字
hotkey=`

# ★ 路径缓存构建用的 es.exe（Everything 命令行）
#   留空/删除本行 → 自动探测（常见安装位置 + PATH），探测不到则路径缓存降级为
#   「App Paths 注册表 + PATH」两级（功能可用，只是找不全 7zFM/Everything 这类不在 PATH 的程序）
espath=

# ★ EV 搜索后端 = Everything SDK 的 DLL（比起 es.exe 子进程快，且能拿全量结果）
#   留空/删除本行 → 自动探测（按序取第一个**存在且能加载**的）：
#     ① <程序目录>\Everything64.dll   ← 随发布包一起发（dist\Everything64.dll）
#     ② %USERPROFILE%\WorkBuddy\Claw\claw-tools\quicknote\everything_sdk\dll\
#     ③ %USERPROFILE%\WorkBuddy\Claw\tools\QuickNote\
#     ④ %TEMP%\runany-src\
#   注意：只认与进程位数匹配的名字（x64 → Everything64.dll；Everything 1.5a 用 Everything3_x64.dll）
#   探针判据 = 命中数 > 0 且 Everything_GetLastError()==0（能加载 ≠ 能用）
#   加载失败/Everything 未运行/IPC 不通 → 自动降级回 es.exe → 再降级到
#   「App Paths + PATH」；**降级态下"全盘自检"只把查不到的程序标成【待确认】，
#   绝不报成「未安装」，也不生成可执行的安装命令**（搜不了 ≠ 没装）。
evdll=

# ★ WebDAV 配置同步（v7）
#   同步范围 = config\menus.conf + config\functions\*.ahk（**不含** auto.conf / cache\paths.txt
#   —— 那些含本机专属项：热键、espath/evdll、绝对路径）
#   规则：双向、按文件修改时间**新者胜**、**覆盖前自动备份**（本地 .bak.<时间戳>／远端 MOVE 到 .bak.<时间戳>）
#   webdavUrl 留空 = 不同步：托盘「同步配置」与启动时同步都会安静跳过，**不动任何文件**
#   ⚠ 密码按 QuickNote 同款做法**明文**存本文件（本文件不进同步范围）；别把本文件外传
webdavUrl=
webdavUser=
webdavPass=
# 远端根下的子目录：默认 RunEver（首次同步会自动 MKCOL 建出来）
#   ⚠ 留空（key 存在但值为空）= 直接用 webdavUrl 指向的目录本身；
#     把这一整行**删掉**才回落到默认值 RunEver —— 两种"空"语义不同，别混
webdavDir=RunEver
# 启动时自动同步：0 = 关（默认）/ 1 = 开（托盘就绪后异步跑，不拖慢启动）
syncOnStart=0

# ── 已取消的两个开关（2026-11-08 定案）──────────────────────────────
# 旧版曾有 captureBackend（ahk / native）与 uiBackend（win32 / wpf）两个可切后端。
# 现在固定：采集 = AHK 常驻管道（CaptureRunner.exe）、菜单 = Win32 TrackPopupMenu。
# 旧配置里若还留着这两行，程序会忽略，不再生效（不是错误）。
